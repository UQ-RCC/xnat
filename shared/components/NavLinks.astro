---
// Top-nav links in the Starlight header. Each site overrides the SocialIcons
// slot with a wrapper that passes its own links.
import Icon from './NavIcon.astro';

interface Props {
  links: { href: string; label: string; title: string; icon: 'external' | 'mail' }[];
}

const { links } = Astro.props;
---

<nav class="nav-links" aria-label="Quick links">
  {
    links.map(({ href, label, title, icon }) =>
      href.startsWith('http') ? (
        <a href={href} target="_blank" rel="noopener noreferrer" title={title}>
          <Icon icon={icon} />
          <span>{label}</span>
        </a>
      ) : (
        <a href={href} title={title}>
          <Icon icon={icon} />
          <span>{label}</span>
        </a>
      ),
    )
  }
</nav>

<style>
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--sl-color-text-accent);
  }
  /* Visually hide labels on narrow viewports without removing accessible names. */
  @media (max-width: 50rem) {
    .nav-links a span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
