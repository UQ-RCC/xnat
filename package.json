{
  "name": "xnat-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs dist",
    "preview": "astro preview",
    "astro": "astro",
    "demo:xnat": "cd demo/sites/xnat && astro dev --port 4321 --host",
    "demo:pitschi": "cd demo/sites/pitschi && astro dev --port 4322 --host",
    "demo:build": "(cd demo/sites/xnat && astro build) && (cd demo/sites/pitschi && astro build)",
    "demo:stop": "(cd demo/sites/xnat && astro dev stop); (cd demo/sites/pitschi && astro dev stop)"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
